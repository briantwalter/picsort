#!/bin/sh

set -eu

repository_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
python="$repository_root/venv/bin/python"

if [ ! -x "$python" ]; then
    printf '%s\n' "picsort: missing executable $python" >&2
    printf '%s\n' "Create the environment with: python3 -m venv venv" >&2
    exit 1
fi

PYTHONPATH="$repository_root/src${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONPATH
exec "$python" -m picsort "$@"
